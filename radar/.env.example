# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth ---
# El mismo client que configuras como proveedor Google en Supabase Auth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Cron ---
# Cadena aleatoria. Protege /api/cron/ingest.
CRON_SECRET=

# --- Tests de integración (opcional) ---
# Postgres efímero para los tests que tocan el esquema.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/radar_test
